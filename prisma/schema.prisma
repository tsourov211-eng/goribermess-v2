datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── NEXT-AUTH DEFAULT MODELS ───
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── MESS MANAGEMENT MODELS ───

// ১. ইউজার টেবিল
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("member")

  // ইউজারের ডিফল্ট মিল সেটিং
  defaultBreakfast Float @default(0.5)
  defaultLunch     Float @default(1.0)
  defaultDinner    Float @default(1.0)

  accounts      Account[]
  sessions      Session[]

  // রিলেশনশিপ
  meals         MealLog[]
  deposits      Deposit[]
  expenses      Expense[] // 💡 নতুন যোগ করা হয়েছে
  bazaarDates   BazaarSchedule[]
  guestMeals    GuestMealRequest[]
}

// ২. প্রতিদিনের মিল সেভ করার টেবিল
model MealLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  date      DateTime
  breakfast Float    @default(0.0)
  lunch     Float    @default(0.0)
  dinner    Float    @default(0.0)
  guest     Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date]) // এক দিনে একজন ইউজারের একটাই লগ থাকবে
}

// ৩. ইউজারের জমা দেওয়া টাকার টেবিল (Deposit)
model Deposit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  amount    Float
  method    String   @default("Cash")    // 💡 Payment Method
  note      String?                      // 💡 User Note
  status    String   @default("Pending") // 💡 Pending, Approved, Rejected
  date      DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ৪. মেসের খরচের টেবিল (Expense / Bazar)
model Expense {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId        // 💡 addedBy এর বদলে userId দেওয়া হয়েছে রিলেশনের জন্য
  amount      Float
  description String?                      // 💡 User Note / Details
  status      String   @default("Pending") // 💡 Pending, Approved, Rejected
  date        DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade) // 💡 রিলেশন যোগ করা হয়েছে
}

// ৫. বাজারের রিকোয়েস্ট ডেট
model BazaarSchedule {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  date      DateTime
  status    String   @default("pending") // pending, approved, completed
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ৬. নোটিশ বোর্ডের টেবিল
model Notice {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  type        String   @default("info") // info, warning, success, alert
  isActive    Boolean  @default(true) 
  createdAt   DateTime @default(now())
}

// ৭. গেস্ট মিল রিকোয়েস্ট টেবিল
model GuestMealRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  date      DateTime
  mealType  String   // Lunch, Dinner, Both
  guests    Int
  status    String   @default("Pending") // Pending, Approved, Rejected
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}